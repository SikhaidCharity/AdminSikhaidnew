# Copy to .env.local.

# Database: the shared Firebase project. The admin only uses its separate v2_ collections and
# the v2/ Storage folder, never the live site's data.
# On this computer: put the downloaded key file at .secrets/firebase-key.json (git-ignored).
# Hosted (Vercel): the key file's contents, base64-encoded, here instead.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Hosted only: a long random text that signs sign-in cookies.
SESSION_SECRET=
# Hosted only: the website project's Vercel Deploy Hook. Saving website content rebuilds the site.
WEBSITE_DEPLOY_HOOK=

# On this computer only: the website folder. Content edits are also copied into its lib/ files
# so the local website shows them at once. Leave empty when hosted.
WEBSITE_DIR=/Users/you/Downloads/New-Sikhaid-Website-
# The website's address while it runs. Used for image previews, and the only site allowed
# to send form entries and donations to this admin.
WEBSITE_URL=http://localhost:3002

# Used once, to create the first (Super Admin) account. After that, change the ID and password
# from Admin → Settings, and add more people from Admin → User Management.
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@sikhaid.local
ADMIN_PASSWORD=choose-a-local-test-password

# WhatsApp (Meta WhatsApp Cloud API) for sending 80G certificates. Leave empty to keep sending off.
# The template must be approved by Meta, with a DOCUMENT header and a body using
# {{1}} for the donor's name and {{2}} for the amount.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
